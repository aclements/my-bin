#!/usr/bin/python3

# Set up a niri session on Debian. Companion to configure-gnome; the shared
# driver and GSettings helpers live in lib/configlib.py.
#
# Debian packages everything niri's "Important Software" wiki page asks for
# except niri and xwayland-satellite, which niri/build compiles in a container.
#
# Run --check (the default) to see what's missing, --apply to do it.

import glob
import json
import os
import os.path
import re
import shutil
import sys
import tempfile

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
import configlib
from configlib import logDo, query, run, sudo

HOME = os.path.expanduser("~")
BIN = os.path.dirname(os.path.realpath(__file__))
DOTFILES = os.path.join(HOME, "sys/dotfiles")
BUILD = os.path.join(BIN, "niri", "build")
OUT = os.path.join(BIN, "niri", "out")

#
# Packages
#

# The desktop tools Debian ships. DankMaterialShell is the whole user-facing
# shell, so there is no waybar/fuzzel/mako/swaylock/swayidle/polkit-agent here.
# The shared libraries niri and friends link against are not listed either --
# see runtime_packages().
PACKAGES = [
    # DMS runs on quickshell and needs these QML modules at runtime. The list
    # comes from upstream's own debian/control, so it is authoritative.
    "quickshell", "cava", "qt6ct", "accountsservice",
    "qml6-module-qtcore", "qml6-module-qtmultimedia", "qml6-module-qtqml",
    "qml6-module-qtquick", "qml6-module-qtquick-controls",
    "qml6-module-qtquick-dialogs", "qml6-module-qtquick-effects",
    "qml6-module-qtquick-layouts", "qml6-module-qtquick-templates",
    "qml6-module-qtquick-window",
    # Portals. xdg-desktop-portal-gnome gives screencasting and needs nautilus
    # for file choosers since version 47; gnome-keyring provides Secret.
    "xdg-desktop-portal-gnome", "xdg-desktop-portal-gtk", "gnome-keyring",
    "nautilus",
    # Clipboard history, which DMS's clipboard panel reads.
    "wl-clipboard", "cliphist",
    # xwayland-satellite execs the real Xwayland.
    "xwayland",
]

def runtime_packages():
    """Debian packages providing the shared libraries the built binaries need.

    Generated by the build container, which is the only thing that can see what
    the binaries actually linked against. A hand-written list does not work: the
    container has every -dev package installed, so a library that is missing on
    the host stays invisible until something fails to start.
    """
    try:
        with open(os.path.join(OUT, "runtime-deps.txt")) as f:
            return f.read().split()
    except FileNotFoundError:
        return []          # nothing built yet

def missing_packages(want):
    p = query(["dpkg-query", "-W", "-f", "${Package} ${Status}\n"] + want)
    have = set()
    for line in p.stdout.splitlines():
        name, _, status = line.partition(" ")
        if status == "install ok installed":
            have.add(name)
    return [pkg for pkg in want if pkg not in have]

def set_packages():
    runtime = runtime_packages()
    want = PACKAGES + [p for p in runtime if p not in PACKAGES]
    missing = missing_packages(want)
    if missing and logDo(f"Installing: {' '.join(missing)}"):
        run(sudo(["apt-get", "install", "-y"] + missing))
    elif not missing:
        print(f"All {len(want)} packages installed")

    # Say plainly how much of that answer is trustworthy: the shared libraries
    # are only known once a build has produced runtime-deps.txt, and that list
    # describes the build it came from, not necessarily the current pins.
    if not runtime:
        print(f"  Shared library packages are unknown until {BUILD} has run")
    else:
        have = built()
        if have and have != pinned():
            print(f"  Library list is from {describe(have)}, "
                  f"pinned at {describe(pinned())}; rerun {BUILD}")
        elif not have:
            print(f"  Library list is from an unknown build; rerun {BUILD}")

#
# Build
#

def set_build():
    want = pinned()
    if not os.path.exists(os.path.join(OUT, "niri")):
        if logDo(f"Building {describe(want)} ({BUILD})"):
            run([BUILD])
        return

    have = built()
    if not have:
        # Predates build-info.txt, so there is no way to know what it is.
        print(f"Built, but of unknown version; rerun {BUILD}")
    elif have != want:
        print(f"Built {describe(have)}, but pinned at {describe(want)}")
        print(f"  Rerun {BUILD}")
    else:
        print(f"Already built ({describe(have)}); rerun {BUILD} to rebuild")

def describe(versions):
    return ", ".join(f"{k.split('_')[0].lower()} {v}" for k, v in sorted(versions.items()))

def versions(lines):
    out = {}
    for line in lines:
        m = re.match(r"([A-Z]+_(?:VERSION|COMMIT))=(\S+)", line)
        if m:
            out[m.group(1)] = m.group(2)
    return out

def pinned():
    """The versions niri/build is pinned to. Read rather than executed, so that
    --check never runs the binaries it is reporting on."""
    with open(BUILD) as f:
        return versions(f)

def built():
    """The versions the current out/ was actually built from, or {} if unknown."""
    try:
        with open(os.path.join(OUT, "build-info.txt")) as f:
            return versions(f)
    except FileNotFoundError:
        return {}

#
# Install
#

# The only file that must be installed system-wide. gdm3 runs as root and lists
# sessions before the user's home is necessarily available, so it cannot read a
# per-user session file. GDM finds this by iterating g_get_system_data_dirs(),
# which defaults to /usr/local/share:/usr/share.
SYSTEM_INSTALL = [
    ("niri.desktop", "/usr/local/share/wayland-sessions", 0o644),
]

# Everything else lives in $HOME. These are all documented search paths that
# already outrank their system equivalents, so nothing is lost by moving:
#   ~/bin                         on the session PATH via environment.d/10-bin.conf
#   ~/.config/systemd/user        ranks above /etc/systemd/user
#                                 (systemd-analyze --user unit-paths)
#   ~/.config/xdg-desktop-portal  highest precedence in portals.conf(5)
#   ~/.local/share/niri           ours alone; only config.kdl's include names it
USER_INSTALL = [
    ("niri",                 "bin",                        0o755),
    ("niri-session",         "bin",                        0o755),
    ("xwayland-satellite",   "bin",                        0o755),
    ("dms",                  "bin",                        0o755),
    ("matugen",              "bin",                        0o755),
    ("dgop",                 "bin",                        0o755),
    ("dsearch",              "bin",                        0o755),
    ("niri.service",         ".config/systemd/user",       0o644),
    ("niri-shutdown.target", ".config/systemd/user",       0o644),
    ("dms.service",          ".config/systemd/user",       0o644),
    ("niri-portals.conf",    ".config/xdg-desktop-portal", 0o644),
    ("default-config.kdl",   ".local/share/niri",          0o644),
    ("danklogo.svg",         ".local/share/icons/hicolor/scalable/apps", 0o644),
    ("dms-desktop/dms-open.desktop",                 ".local/share/applications", 0o644),
    ("dms-desktop/com.danklinux.dms.desktop",        ".local/share/applications", 0o644),
    ("dms-desktop/com.danklinux.dms.notepad.desktop", ".local/share/applications", 0o644),
]

# Directories staged by the build. Replaced wholesale on install, so a DMS
# upgrade cannot leave stale QML behind to be loaded alongside the new tree.
# Directories staged by the build. The destination is wiped first, so a DMS
# upgrade cannot leave stale QML behind to be loaded next to the new tree.
TREES = [
    # DMS looks for shell.qml in $XDG_CONFIG_HOME/quickshell/dms, then in
    # XDG_DATA_DIRS and XDG_CONFIG_DIRS -- note DIRS, never XDG_DATA_HOME. So
    # ~/.local/share/quickshell/dms is not a path it searches, even though
    # that is where DMS's own Makefile puts it under a user PREFIX; that
    # target only works because the default PREFIX=/usr/local lands in
    # XDG_DATA_DIRS. See core/internal/config/dms.go:LocateDMSConfig.
    ("dms-shell", ".config/quickshell/dms"),
]

# Line rewrites applied to files coming out of the build, keyed by file name.
# The whole line must match, and set_install refuses to continue if a patch stops
# applying, so an upstream change cannot silently drop one.
PATCHES = {
    "default-config.kdl": [
        # Our config.kdl includes this file and overrides it, but an include can
        # only add settings, and spawn-at-startup accumulates with no way to
        # unset it. Waybar runs as a systemd service here, so comment upstream's
        # copy out using KDL's /- node-comment token to avoid starting a second.
        ('spawn-at-startup "waybar"', '/-spawn-at-startup "waybar"'),
    ],
    "niri.service": [
        # niri lives in ~/bin, which is not on any system PATH. %h is systemd's
        # own home-directory specifier, so this stays portable between machines
        # and does not depend on what the session manager's PATH happens to be.
        ("ExecStart=niri --session", "ExecStart=%h/bin/niri --session"),
    ],
    "dms.service": [
        # Same reasoning as niri.service: dms lives in ~/bin, and %h is
        # systemd's home-directory specifier.
        ("ExecStart=/usr/bin/dms run --session",
         "ExecStart=%h/bin/dms run --session"),
    ],
    "niri.desktop": [
        # GDM's session worker resolves this before any user environment exists,
        # so it needs a literal absolute path -- specifiers and PATH are both
        # unavailable. This is the one place $HOME is baked in, in the one file
        # that has to be system-wide anyway.
        ("Exec=niri-session", f"Exec={HOME}/bin/niri-session"),
    ],
}

def patch(name, text):
    for old, new in PATCHES.get(name, []):
        # Anchored, so a mention inside a comment does not match.
        pat = re.compile("^" + re.escape(old) + "$", re.M)
        if pat.search(text):
            text = pat.sub(lambda m: new, text)
        elif not re.search("^" + re.escape(new) + "$", text, re.M):
            raise ValueError(
                f"patch no longer applies to {name}: {old!r} not found. "
                "Upstream probably changed it; check whether the patch is still "
                "needed and update PATCHES in configure-niri.")
    return text

def set_install():
    want = ([name for name, _, _ in SYSTEM_INSTALL + USER_INSTALL]
            + [name for name, _ in TREES])
    absent = [n for n in want if not os.path.exists(os.path.join(OUT, n))]
    if len(absent) == len(want):
        print("Nothing built yet; run the build category first")
        return
    if absent:
        # A partial out/ means an interrupted or failed build, not something to
        # install half of.
        print(f"Incomplete build in {OUT}, missing: {' '.join(absent)}")
        print(f"  Rerun {BUILD}")
        return

    broken = {b: unresolved(os.path.join(OUT, b))
              for b in ("niri", "xwayland-satellite")}
    broken = {b: libs for b, libs in broken.items() if libs}
    if broken:
        for b, libs in broken.items():
            print(f"{b}: unresolved libraries: {' '.join(libs)}")
        print(f"  Provided by packages in {os.path.join(OUT, 'runtime-deps.txt')}")
        print("  Run: configure-niri --apply packages")
        return

    for name, dstdir, mode in SYSTEM_INSTALL:
        install_file(staged(name), os.path.join(dstdir, name), mode, root=True)

    units = False
    for name, dstdir, mode in USER_INSTALL:
        dst = os.path.join(HOME, dstdir, os.path.basename(name))
        changed = install_file(staged(name), dst, mode)
        units = units or (changed and dstdir.endswith("systemd/user"))

    for name, dstdir in TREES:
        install_tree(name, dstdir)

    # A unit that changed on disk is not live until the manager re-reads it.
    if units and logDo("systemctl --user daemon-reload"):
        run(["systemctl", "--user", "daemon-reload"])

def unresolved(binary):
    """Shared libraries the dynamic linker cannot find for binary."""
    out = query(["ldd", binary]).stdout
    return [l.split("=>")[0].strip() for l in out.splitlines() if "not found" in l]

def staged(name):
    """The bytes to install for one file out of the build."""
    content = open(os.path.join(OUT, name), "rb").read()
    base = os.path.basename(name)
    if base in PATCHES:
        content = patch(base, content.decode()).encode()
    return content

def install_file(content, dst, mode, root=False):
    """Install content at dst. Returns whether it changed, or would have."""
    try:
        with open(dst, "rb") as f:
            if f.read() == content:
                return False
    except (FileNotFoundError, PermissionError):
        pass
    if not logDo(f"Installing {dst}"):
        return True
    configlib.checkApply(dst)
    if root:
        with tempfile.NamedTemporaryFile() as tf:
            tf.write(content)
            tf.flush()
            # install -D creates the parent directories.
            run(sudo(["install", "-D", "-m", f"{mode:o}", tf.name, dst]))
    else:
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        # Write and rename rather than rewriting in place: this may be the very
        # binary the running session is executing, which would give ETXTBSY.
        tmp = dst + ".new"
        with open(tmp, "wb") as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, dst)
    return True

def install_tree(name, dstdir):
    """Replace a directory with the one staged by the build.

    Returns whether it changed, or would have.
    """
    src = os.path.join(OUT, name)
    dst = os.path.join(HOME, dstdir)

    # Comparing 800-odd files every run would be slow, and this tree only ever
    # changes when the build does, so stamp it with the build it came from.
    stamp = os.path.join(dst, ".installed-from")
    want = staged("build-info.txt")
    try:
        with open(stamp, "rb") as f:
            if f.read() == want:
                return False
    except FileNotFoundError:
        pass
    if not logDo(f"Installing {dst}/"):
        return True
    configlib.checkApply(dst)
    tmp = dst + ".new"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copytree(src, tmp)
    with open(os.path.join(tmp, ".installed-from"), "wb") as f:
        f.write(want)
    shutil.rmtree(dst, ignore_errors=True)
    os.rename(tmp, dst)
    return True

#
# Config file links
#

# ~/.config/niri/config.kdl is deliberately a real file rather than a symlink
# into sys/dotfiles. DankMaterialShell appends `include "dms/*.kdl"` lines to it
# from its settings GUI, and it does so with >>, which follows a symlink and
# would write straight into the git-managed dotfile. Keeping the entry point a
# real file gives DMS somewhere to write and leaves ours alone.
#
# niri resolves a relative include against the directory of the file containing
# it, so DMS's "dms/..." paths land in ~/.config/niri/dms/ as it expects.
ENTRY = ".config/niri/config.kdl"
ENTRY_INCLUDE = 'include "~/sys/dotfiles/niri/config.kdl"'
ENTRY_TEMPLATE = f"""\
// niri configuration entry point.
//
// Personal configuration lives in the include below, under version control in
// ~/sys/dotfiles. This file is NOT a symlink to it on purpose: DankMaterialShell
// appends its own `include "dms/*.kdl"` lines here when you use its settings
// GUI, and appending through a symlink would write into the dotfile.
//
// DMS's includes land after ours, so its GUI-managed settings take precedence.

{ENTRY_INCLUDE}
"""

def set_links():
    entry_config()

    # ~/bin only reaches the PATH of login shells, via zprofile. Anything the
    # session spawns -- niri key bindings included -- gets its PATH from the
    # systemd user manager instead, so without this ~/bin is invisible and
    # "x-terminal-emulator" silently resolves to /usr/bin's gnome-terminal.
    # sys/dotfiles/setup owns that file, so just report on it here.
    envd = os.path.join(HOME, ".config/environment.d/10-bin.conf")
    if not os.path.lexists(envd):
        print(f"Missing {envd}; run {DOTFILES}/setup")
    if not os.path.lexists(os.path.join(HOME, "bin/x-terminal-emulator")):
        print(f"Missing ~/bin/x-terminal-emulator; "
              f"ln -s ../sys/bin/x-terminal-emulator ~/bin/")

# The fragments DMS generates under ~/.config/niri/dms/. Adding these includes
# ourselves is what the "Setup" buttons in DMS's settings would otherwise do:
# they append exactly these lines to the entry config. Writing them here means
# the buttons show as already configured and never touch the file.
#
# DMS registers includes for the first six. It generates alttab.kdl and
# wpblur.kdl too but never offers to include them, so those features are dead
# unless we do it. All are touched into existence by DMS even when empty, and an
# empty include is harmless -- they take effect as you configure things in DMS.
DMS_INCLUDES = [
    "layout", "colors", "windowrules", "cursor", "outputs", "binds",
    "alttab", "wpblur",
]

def entry_config():
    dst = os.path.join(HOME, ENTRY)

    if os.path.islink(dst):
        # Left over from when this was symlinked into sys/dotfiles.
        if logDo(f"Replacing symlink {dst} with a real file"):
            configlib.checkApply(dst)
            os.unlink(dst)
        else:
            return

    try:
        with open(dst) as f:
            body = f.read()
    except FileNotFoundError:
        install_file(ENTRY_TEMPLATE.encode(), dst, 0o644)
        return

    if ENTRY_INCLUDE not in body:
        print(f"{dst} does not include the managed config; add:")
        print(f"  {ENTRY_INCLUDE}")

    dms_includes(dst)

def dms_includes(dst):
    """Ensure the DMS fragment includes are present in the entry config.

    Appends only what is missing, the same way DMS itself does, so this stays
    idempotent and neither of us fights the other over the file.
    """
    with open(dst) as f:
        # Match DMS's own check, which ignores commented-out lines.
        live = [l for l in f.read().splitlines()
                if not l.lstrip().startswith(("//", "#"))]

    missing = [n for n in DMS_INCLUDES
               if not any(f'"dms/{n}.kdl"' in l for l in live)]
    if not missing:
        return
    lines = [f'include "dms/{n}.kdl"' for n in missing]
    if not logDo(f"Adding to {dst}: {' '.join(missing)}"):
        return
    configlib.checkApply(dst)
    with open(dst, "a") as f:
        if not any(l.startswith("// DankMaterialShell") for l in live):
            f.write("\n// DankMaterialShell fragments, generated from its settings.\n")
        f.write("\n".join(lines) + "\n")

#
# Session services
#

# Started with the niri session. DMS is the whole user-facing shell now: bar,
# launcher, notifications, lock, idle, wallpaper and polkit agent.
SERVICES = ["dms.service"]

def set_services():
    wants = os.path.join(HOME, ".config/systemd/user/niri.service.wants")

    # The session should want exactly SERVICES. Anything else here would keep
    # starting at login, and systemd reports it as failed once it is gone.
    if os.path.isdir(wants):
        for stale in sorted(set(os.listdir(wants)) - set(SERVICES)):
            if logDo(f"Dropping {stale} from niri.service.wants"):
                configlib.checkApply(stale)
                os.unlink(os.path.join(wants, stale))

    bus_conflicts()

    missing = [s for s in SERVICES if not os.path.lexists(os.path.join(wants, s))]
    if not missing:
        print(f"All {len(SERVICES)} services wanted by niri.service")
        return
    if logDo(f"systemctl --user add-wants niri.service {' '.join(missing)}"):
        # Pick up units linked in by set_links.
        run(["systemctl", "--user", "daemon-reload"])
        run(["systemctl", "--user", "add-wants", "niri.service"] + missing)

def bus_conflicts():
    """Report other units claiming a D-Bus name one of ours also claims.

    systemd refuses to load a unit whose BusName= is already taken by another
    unit, whether or not that other unit is enabled or running. A leftover
    notification daemon therefore stops DMS loading at all, and the symptom is a
    session with no bar and dead key bindings rather than an error you would
    think to look for.
    """
    for svc in SERVICES:
        ours = os.path.join(HOME, ".config/systemd/user", svc)
        bus = bus_name(ours)
        if bus is None:
            continue
        for d in ("/usr/lib/systemd/user", "/etc/systemd/user",
                  os.path.join(HOME, ".config/systemd/user")):
            for other in sorted(glob.glob(os.path.join(d, "*.service"))):
                if os.path.realpath(other) == os.path.realpath(ours):
                    continue
                if bus_name(other) != bus:
                    continue
                name = os.path.basename(other)
                print(f"{name} also claims {bus}, so systemd will refuse to")
                print(f"  load {svc}. Remove {owning_package(other) or 'its package'}, "
                      f"or: systemctl --user mask {name}")

def bus_name(unit):
    try:
        with open(unit) as f:
            for line in f:
                if line.startswith("BusName="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return None

def owning_package(path):
    out = query(["dpkg-query", "-S", path]).stdout
    return out.split(":", 1)[0] if out else None

#
# DankMaterialShell settings
#

DMS_BIN = os.path.join(HOME, "bin/dms")

# DMS keeps user settings in three separate files, and offers a different way to
# set each. A key may carry a namespace prefix; a bare key means the main
# settings store:
#
#   <key>              ~/.config/DankMaterialShell/settings.json
#                      via `dms ipc call settings set` -- scalars only, since
#                      that call refuses objects and arrays (see OBJECT_BUG)
#   clipboard/<key>    ~/.config/DankMaterialShell/clsettings.json
#                      via `dms clipboard config set`, which takes flags rather
#                      than key/value, so only the keys in CLIPBOARD_FLAGS work
#
# The third store, ~/.local/state/DankMaterialShell/session.json (weather
# coordinates, night mode, wallpaper), has no generic setter at all. The
# wallpaper has its own IPC call and is handled below; the rest can only be set
# through the DMS GUI. dms-diff reports all three.
#
# We drive settings through IPC rather than editing the files: DMS holds them
# open with watchChanges and atomicWrites, so a direct write races whatever it
# has in memory, while IPC validates and applies immediately. It is the same
# shape as gsettings, so --check/--apply/--list behave the same way here.
#
# DMS's `settings set` throws "Setting Objects and Arrays not supported" for any
# non-scalar, so settings like barConfigs cannot be captured here at all. That is
# deliberate on their side, waiting on quickshell gaining a way to pass
# structured JSON over IPC:
#
#   https://github.com/quickshell-mirror/quickshell/pull/22
#   "cli: add `callJson` ipc subcommand" -- open since 2025-03-02
#
# DMSShellIPC.qml cites that PR at the `case "object":` branch. If it merges and
# DMS enables the branch, object and array settings become capturable and dset()
# below can drop its restriction.
OBJECT_BUG = "https://github.com/quickshell-mirror/quickshell/pull/22"

# Settings worth carrying between machines go here, as (key, value).
DMS_SETTINGS = [
    # Derive the whole palette from the wallpaper via matugen, rather than
    # using one of DMS's fixed palettes. The UI sets both of these together
    # (Theme.switchThemeCategory("dynamic", Theme.dynamic)), and setting only
    # one leaves the theme on a fixed colour.
    ("currentThemeName", "dynamic"),
    ("currentThemeCategory", "dynamic"),

    # Lock on lid close. DMS ships lockBeforeSuspend off, so closing the lid
    # suspends without locking and you resume to an unlocked screen. The
    # timeouts are the idle behaviour around it, in seconds.
    ("lockBeforeSuspend", True),
    ("acLockTimeout", 600),
    ("batteryLockTimeout", 600),

    # Power settings
    ("acPostLockMonitorTimeout", 60),
    ("acSuspendTimeout", 7200),
    ("acProfileName", "2"),
    ("batteryPostLockMonitorTimeout", 60),
    ("batterySuspendTimeout", 900),
    ("batteryProfileName", "1"),

    # Monitor switching
    ('displayNameMode', 'model'),
    ('displayProfileAutoSelect', True),

    # Misc
    ('launcherStyle', 'spotlight'),
    ('notificationShowTimeoutBar', True),
    ('showWorkspaceIndex', True),
    ('useFahrenheit', True),

    # Clipboard works but nothing is written to disk. Off by default.
    ("clipboard/disabled", True),
]

# `dms clipboard config set` takes flags, not key/value. A pair is
# (flag-when-true, flag-when-false); a string is a flag taking the value.
# maxEntrySize and maxPinned have no flag, so they cannot be set this way.
CLIPBOARD_FLAGS = {
    "disabled": ("--disable", "--enable"),
    "clearAtStartup": ("--clear-at-startup", "--no-clear-at-startup"),
    "maxHistory": "--max-history",
    "autoClearDays": "--auto-clear-days",
}

# The wallpaper is not a setting: it lives in session state
# (~/.local/state/DankMaterialShell/session.json) and has its own IPC call.
#
# ~/Pictures/Wallpapers rather than ~/.local/share/wallpapers: there is no XDG
# spec for user wallpapers, and DMS has no wallpaper-directory setting of its
# own, so the only real standard in play is XDG_PICTURES_DIR from
# ~/.config/user-dirs.dirs. Downloaded images are user data, not app data.
#
# Set WALLPAPER to a filename in WALLPAPER_DIR once you have one; None leaves
# whatever DMS is already using alone. matugen derives the whole colour scheme
# from it, so one or two dominant hues theme far more coherently than a busy
# image.
WALLPAPER_DIR = "Pictures/Wallpapers"
WALLPAPER = "mark-harpur-K2s_YE031CA-unsplash.jpg"

def namespaced(key):
    """Split a DMS setting key into (namespace, key)."""
    ns, sep, rest = key.partition("/")
    return (ns, rest) if sep else ("settings", key)

_clipboard = None

def clipboard_config():
    """The clipboard store, read once per run."""
    global _clipboard
    if _clipboard is None:
        p = query([DMS_BIN, "clipboard", "config", "get"])
        try:
            _clipboard = json.loads(p.stdout)
        except ValueError:
            _clipboard = {}
    return _clipboard

def dget(key):
    """Current value of a DMS setting, in whichever store holds it."""
    ns, key = namespaced(key)
    if ns == "clipboard":
        return clipboard_config().get(key)

    # `settings get` returns the value JSON-encoded, so a string comes back as
    # "purple" rather than purple. `settings set` takes it raw -- feeding one
    # straight into the other double-encodes it.
    p = query([DMS_BIN, "ipc", "call", "settings", "get", key])
    out = p.stdout.strip()
    if p.returncode != 0 or out in ("", "undefined"):
        return None
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return out

def dset(key, value):
    have = dget(key)
    if have != value or configlib.mode == "list":
        print(f"dms {key}")
        print(f"  Current: {have!r}")
        print(f"  New:     {value!r}")
    if have == value or configlib.mode != "apply":
        return

    ns, name = namespaced(key)
    if ns == "clipboard":
        flag = CLIPBOARD_FLAGS.get(name)
        if flag is None:
            print(f"  Cannot set {key}: dms clipboard config set has no flag "
                  f"for it")
            return
        args = ([flag[0] if value else flag[1]] if isinstance(flag, tuple)
                else [flag, str(value)])
        run([DMS_BIN, "clipboard", "config", "set"] + args)
        global _clipboard
        _clipboard = None          # re-read rather than trust our own write
    else:
        # Raw for strings, JSON for everything else -- see dget.
        raw = value if isinstance(value, str) else json.dumps(value)
        run([DMS_BIN, "ipc", "call", "settings", "set", name, raw])

def session_value(key):
    try:
        with open(os.path.join(HOME, ".local/state/DankMaterialShell/session.json")) as f:
            return json.load(f).get(key)
    except (OSError, ValueError):
        return None

def uncaptured():
    """Settings changed from default that DMS_SETTINGS does not declare.

    These live only on this machine: a reinstall would not reproduce them.
    dms-diff does the comparison -- it reads the defaults out of
    SettingsData.qml, which is the only place they are written down.
    """
    p = query([os.path.join(BIN, "dms-diff"), "--json"])
    if p.returncode != 0:
        return {}
    try:
        drift = json.loads(p.stdout)
    except ValueError:
        return {}
    declared = {name for k, _ in DMS_SETTINGS
                for ns, name in [namespaced(k)] if ns == "settings"}
    return {k: v for k, v in drift.items() if k not in declared}

def set_dms():
    if query(["systemctl", "--user", "is-active", "dms.service"]).stdout.strip() != "active":
        print("DMS is not running, so its settings cannot be read or set")
        print("  systemctl --user start dms.service, then re-run")
        return

    for key, value in DMS_SETTINGS:
        dset(key, value)

    extra = uncaptured()
    # `settings set` refuses objects and arrays -- see OBJECT_BUG above -- so
    # those cannot be captured this way even though they have drifted.
    settable = {k: v for k, v in extra.items()
                if not isinstance(v, (dict, list))}
    unsettable = sorted(set(extra) - set(settable))
    if settable:
        print(f"{len(settable)} DMS setting(s) differ from default but are not "
              f"in DMS_SETTINGS,")
        print("  so a reinstall would not reproduce them:")
        for key, value in sorted(settable.items()):
            print(f"    ({key!r}, {value!r}),")
    if unsettable:
        print(f"{len(unsettable)} more have drifted but are objects or arrays, "
              f"which DMS's IPC")
        print(f"  refuses to set: {' '.join(unsettable)}")
        print("  They can only be reproduced through the DMS GUI, until")
        print(f"  {OBJECT_BUG} lands.")
    if extra:
        print(f"  {os.path.join(BIN, 'dms-diff')} shows the full picture, "
              f"including the")
        print("  session-state and clipboard stores, which live in other files.")

    if WALLPAPER is None:
        print(f"No wallpaper declared; put one in ~/{WALLPAPER_DIR}, "
              f"then set WALLPAPER in {os.path.basename(__file__)}")
        return
    want = os.path.join(HOME, WALLPAPER_DIR, WALLPAPER)
    if not os.path.exists(want):
        print(f"Wallpaper missing: {want}")
    elif session_value("wallpaperPath") != want:
        print(f"dms wallpaper")
        print(f"  Current: {session_value('wallpaperPath')!r}")
        print(f"  New:     {want!r}")
        if configlib.mode == "apply":
            run([DMS_BIN, "ipc", "call", "wallpaper", "set", want])

#
# Desktop settings
#

def set_desktop():
    # Dark mode and fonts reach GTK and Flatpak apps under niri through the
    # Settings interface of xdg-desktop-portal-{gtk,gnome}.
    configlib.set_common()

# Order matters: set_build produces runtime-deps.txt, which set_packages needs,
# and set_install refuses to run until those packages are in place.
configlib.main([
    set_build,
    set_packages,
    set_install,
    set_links,
    set_services,
    set_desktop,
    set_dms,
])
